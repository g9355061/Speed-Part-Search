# DigiKey Production API
DIGIKEY_CLIENT_ID=your_client_id_here
DIGIKEY_CLIENT_SECRET=your_client_secret_here
DIGIKEY_ENV=production
DIGIKEY_LOCALE_SITE=US
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=USD

# Mouser HK API
MOUSER_HK_API_KEY=your_mouser_hk_api_key_here

# Mouser VN API
MOUSER_VN_API_KEY=your_mouser_vn_api_key_here

# Optional: Mouser throttle (default 2100ms)
# MOUSER_MIN_INTERVAL_MS=2100
