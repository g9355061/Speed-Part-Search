# ===== Auth =====
# Required: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=your_nextauth_secret_here
# Required: the public URL of your deployment
NEXTAUTH_URL=https://your-domain.up.railway.app

# Optional: default admin password (used only when seeding new admin accounts)
# DEFAULT_ADMIN_PASSWORD=SpeedPart@2026!

# Optional: SQLite DB path (default: ./data/users.db)
# On Railway, mount a volume at /data and set DB_PATH=/data/users.db
# DB_PATH=/data/users.db

# Optional: Email (SMTP) for password reset and approval notifications
# Without these, reset links are logged to console only
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Speed Part Search <noreply@your-domain.com>

# ===== DigiKey Production API =====
DIGIKEY_CLIENT_ID=your_client_id_here
DIGIKEY_CLIENT_SECRET=your_client_secret_here
DIGIKEY_ENV=production
DIGIKEY_LOCALE_SITE=US
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=USD
# 第二幣別（同一把 key，只換 locale header）；只有 /api/search 會用
DIGIKEY_ALT_LOCALE_SITE=CN
DIGIKEY_ALT_LOCALE_LANGUAGE=zh
DIGIKEY_ALT_LOCALE_CURRENCY=CNY

# Mouser HK API
MOUSER_HK_API_KEY=your_mouser_hk_api_key_here

# Mouser VN API
MOUSER_VN_API_KEY=your_mouser_vn_api_key_here

# Mouser CN API（mouser.cn 中國站，人民幣報價）
MOUSER_CN_API_KEY=your_mouser_cn_api_key_here

# Optional: Mouser throttle (default 2100ms)
# MOUSER_MIN_INTERVAL_MS=2100

# ===== Weekly report email (disabled until the test email is approved) =====
# Uses the same Gmail OAuth sender account as Issue Tracking System.
# Store actual credentials only in Railway variables / ignored local env files.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM=Speed Part Search <fxnebg@gmail.com>
WEEKLY_REPORT_EMAIL_ENABLED=false
# Once approved, set true: every active admin receives one email per issue.
# Existing weekly-report-build schedule: Monday 05:23 Asia/Taipei (may be delayed by GitHub).
# Cron-authenticated POST .../weekly-reports/deliver?test=1 sends only to g9355061@gmail.com.
# Test and live delivery records are separate; force=1 explicitly resends.
